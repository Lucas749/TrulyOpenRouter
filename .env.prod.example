# Production env — copy to .env.prod next to docker-compose.prod.yml and fill in.
# NEVER commit .env.prod. Values below are placeholders, not secrets.

# --- domain (optional) ---
# Nothing on the box terminates TLS: the gateway is plain HTTP on :4121 and the
# public HTTPS surface is Vercel's. Only set this if you front the box yourself.
# APP_HOST=app.example.com

# --- shared operator secret (must match on web + gateway; invent one) ---
GATEWAY_ADMIN_TOKEN=PASTE_openssl_rand_hex_24

# --- postgres ---
# Local compose: leave HOST unset (uses the db container). AWS: set HOST to the
# RDS endpoint from terraform output, USER/PASSWORD to the RDS master creds.
POSTGRES_DB=tor
POSTGRES_USER=tor
POSTGRES_PASSWORD=PASTE_openssl_rand_hex_24
# POSTGRES_HOST=tor-xxx.eu-west-1.rds.amazonaws.com

# --- host payout (your Hedera account, receives $0.001 USDC per call) ---
HOST_WALLET=0.0.YOU

# --- local serving (compose DNS name of the bundled guard) ---
# payee: the EVM alias of HOST_WALLET (mirror node evm_address). The gateway pays the bundled guard only there.
HOSTS_JSON=[{"endpoint":"http://guard:4122","modelId":"qwen2.5:0.5b","pricePerReq":1,"pricePer1kTokens":0,"payee":"PASTE_HOST_WALLET_EVM_ALIAS"}]

# --- chain (testnet defaults are live; mainnet = redeploy contracts first) ---
REGISTRY=0x5f83c19413fc15181e2e79512947e374c7b8dc56
LEGACY_REGISTRIES=0xa45461bdefef422a81b22f36ebfd0995c7642dc3
# Registry holding the existing demo host stake for device-approved taps.
TAP_REGISTRY=0xa45461bdefef422a81b22f36ebfd0995c7642dc3
RPC_URL=https://testnet.hashio.io/api
MODELS=qwen2.5:0.5b
VAULT_ADDRESS=0xd75c46c0e82115ab4d24326dbbbbffe4e7d0c576
TAP_HEDERA_ACCOUNT=0.0.YOUR_LEDGER_ACCOUNT
MIRROR_URL=https://testnet.mirrornode.hedera.com

# --- gateway secrets (env-fallback on VPS; laptop demo uses the ring) ---
# BUDGET_MASTER: random 32-byte hex you generate ONCE (it derives budget accounts)
BUDGET_MASTER=PASTE_openssl_rand_hex_32
OPERATOR_KEY=PASTE_deployer_or_vault_operator_key
X402_PAYER_ID=0.0.AGENT
X402_PAYER_KEY=PASTE_agent_key
# Host payment bounds in test USDC units (6 decimals): per payment, per UTC day, and payments per day
X402_MAX_PAYMENT_UNITS=10000
X402_DAILY_CAP_UNITS=2000000
X402_DAILY_PAYMENTS=2000
HCS_TOPIC_ID=0.0.10379640
HCS_OPERATOR_ID=0.0.DEPLOYER
HCS_OPERATOR_KEY=PASTE_deployer_key
HOST_KEY=PASTE_demo_host_key_for_tap_execution

# --- team treasury (Privy organization wallets) ---
# PRIVY_BROKER_AUTH_KEY: P-256 private key, base64 PKCS8 without PEM headers.
# Generate once; its public half co-owns every team wallet quorum with the
# team's financial approver, so it can never move team funds alone.
PRIVY_BROKER_AUTH_KEY=PASTE_base64_pkcs8_p256
TEAM_PLAN_IDS=0
TEAM_PAYOUT_CAP_HBAR=25
TEAM_PAYOUT_CAP_USDC=5

# --- web (Privy dashboard -> your app -> allowed origins += https://APP_HOST) ---
# NOTE: the app id is NEXT_PUBLIC_* (baked into the client bundle at build time).
NEXT_PUBLIC_PRIVY_APP_ID=PASTE
PRIVY_APP_SECRET=PASTE
